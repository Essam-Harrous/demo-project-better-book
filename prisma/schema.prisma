generator client {
  provider = "prisma-client"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  name      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  password  String
  workouts        Workout[]
  weightTrackings WeightTracking[]
  nutritionLogs   NutritionLog[]
  role            Role             @default(USER)
  stats           UserStats?
}

model UserStats {
  userId             String   @id
  user               User     @relation(fields: [userId], references: [id])
  totalWorkouts      Int      @default(0)
  totalWeightEntries Int      @default(0)
  currentStreak      Int      @default(0)
  lastActiveAt       DateTime @default(now())

  @@index([totalWorkouts(sort: Desc)])
  @@index([currentStreak(sort: Desc)])
  @@index([lastActiveAt(sort: Desc)])
}

model Movement {
  id   String @id @default(uuid())
  name String @unique
  sets Set[]
  isBodyWeight Boolean @default(false)
}

model Workout {
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  id          String    @id @default(uuid())
  completedAt DateTime?
  sets        Set[]

  @@index([userId, completedAt])
}

model Set {
  id         String   @id @default(uuid())
  workoutId  String
  workout    Workout  @relation(fields: [workoutId], references: [id])
  movementId String
  movement   Movement @relation(fields: [movementId], references: [id])
  reps       Int
  weight     Int
}


model WeightTracking {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  weight      Float
  createdAt   DateTime  @default(now())

  @@index([userId, createdAt])
}

model NutritionLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  name      String
  calories  Int
  protein   Int      // in grams
  carbs     Int      // in grams
  fats      Int      // in grams
  date      DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([userId, date])
}
